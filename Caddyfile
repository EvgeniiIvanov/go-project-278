{
	auto_https off
	admin off
}

:{$PORT:80} {
	encode gzip

	# Backend API, health check, and short-link redirects.
	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle /ping {
		reverse_proxy 127.0.0.1:8080
	}

	handle /r/* {
		reverse_proxy 127.0.0.1:8080
	}

	# Frontend SPA assets + fallback.
	handle {
		root * /app/public
		try_files {path} /index.html
		file_server
	}
}