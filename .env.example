# Application
PORT=8080
SHORT_URL=http://127.0.0.1:8080
APP_ENV=development
LOG_LEVEL=debug

# CORS (comma-separated). Frontend dev server default:
CORS_ORIGINS=http://localhost:5173

# Sentry (optional)
SENTRY_DSN=

# Database
POSTGRES_USER=shortener
POSTGRES_PASSWORD=dev_password_123
POSTGRES_DB=shortener_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# godotenv does not expand ${VAR}, so set the full URL explicitly
DATABASE_URL=postgres://shortener:dev_password_123@localhost:5432/shortener_dev?sslmode=disable

# Postgres pool settings
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTHCHECK_PERIOD=1m

# Test database
POSTGRES_TEST_DB=shortener_test
TEST_DATABASE_URL=postgres://shortener:dev_password_123@localhost:5432/shortener_test?sslmode=disable
